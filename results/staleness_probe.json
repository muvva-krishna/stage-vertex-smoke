{
  "title": "Revision-aware filtering for stale debugging context",
  "date": "2026-11-01",
  "synthetic": true,
  "question": "Does filtering debugging evidence to the current code revision reduce file-localization errors from stale notes?",
  "design": {
    "cases": 8,
    "conditions": [
      "clean",
      "stale_only",
      "fresh_plus_stale"
    ],
    "methods": [
      "issue_only",
      "all_evidence",
      "revision_gated"
    ],
    "trials": 72,
    "scoring": "distinct issue-term overlap plus one vote per evidence-term occurrence; deterministic lexical ranking; ties broken by path",
    "fresh_revision": "rev-current",
    "stale_revision": "rev-previous"
  },
